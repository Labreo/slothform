# ==============================================================================
# SlothForm Environment Configuration
# ==============================================================================

# --- Browserbase (Headless Cloud Browser) ---
# Sign up at https://browserbase.com to get your API Key and Project ID
BROWSERBASE_API_KEY=bb_live_your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here

# --- Paper Instruments / Ultramarine ---
# Paper Instruments API Key for Ultramarine model reasoning
PAPER_INSTRUMENTS_API_KEY=pi_live_your_paper_instruments_api_key_here
ULTRAMARINE_MODEL=ultramarine-1-flash

# --- Auth0 for AI Agents ---
# Configured in Auth0 Dashboard under Applications -> APIs / CIBA settings
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_AUDIENCE=https://api.slothform.internal
AUTH0_TOKEN_VAULT_KEY=your_aes256_vault_encryption_key

# --- Application Server & Security ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
SECRET_KEY=generate_a_random_32_byte_secret_key_here

# --- Sentry Agent Tracing (Optional / Sponsor Bounty) ---
SENTRY_DSN=
